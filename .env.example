# IC CRM: variáveis das Edge Functions (Supabase). SEM valores reais.
# Cadastre com:  supabase secrets set NOME=valor
# Detalhes de cada uma em supabase/functions/LEIA-IC.md (seção 6).
# O front (index.html) NÃO usa este arquivo: ele lê URL e chave anon de config.js.

# Injetadas pelo próprio Supabase nas functions (não precisa cadastrar)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp (Meta)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Transcrição de áudio
GROQ_API_KEY=

# Assistente virtual de pré-atendimento
ANTHROPIC_API_KEY=
IC_POLITICA_PRIVACIDADE_URL=

# Entre funções e criptografia
IC_INTERNAL_SECRET=
IC_CRYPTO_KEY=
IC_APP_URL=

# Google Agenda (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
